# =====================================================================
# LOBOKO — Variables d'environnement Frontend (Supabase)
# =====================================================================
#
# Copiez ce fichier en .env.local pour le développement local :
#   cp .env.example .env.local
#
# En production (Vercel), ajoutez ces DEUX variables dans :
#   Vercel → Project → Settings → Environment Variables
# (Environnements cochés : Production, Preview, Development)
#
# ---------------------------------------------------------------------

# URL publique de votre projet Supabase
# Format : https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Clé publique "anon" de votre projet Supabase (SAFE pour le frontend)
# ⚠️ NE JAMAIS utiliser la service_role key ici
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---------------------------------------------------------------------
# TURN server (optionnel mais fortement recommandé pour les appels
# audio/vidéo WebRTC sur 4G, Wi-Fi public, iOS, réseaux stricts).
#
# Si ces 3 variables sont vides, l'app utilise uniquement les serveurs
# STUN publics Google — les appels peuvent alors échouer au stade ICE
# entre deux pairs derrière un NAT symétrique.
#
# Sources possibles d'un TURN :
#   - Twilio Network Traversal Service
#   - Xirsys
#   - Cloudflare Calls
#   - CoTURN self-hosted
#
# VITE_TURN_URL accepte une URL unique OU une liste séparée par virgules
# pour supporter plusieurs transports, ex :
#   VITE_TURN_URL=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
# ---------------------------------------------------------------------
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=