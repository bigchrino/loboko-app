# =============================================================================
# LOBOKO Frontend – Environment Variables
# =============================================================================
#
# Copy this file to `.env` (local dev) or configure these variables in your
# hosting provider dashboard (e.g. Vercel → Settings → Environment Variables).
#
# -----------------------------------------------------------------------------
# VITE_ATOMS_API_URL  (REQUIRED in production on Vercel)
# -----------------------------------------------------------------------------
# Public base URL of the Atoms Cloud backend that serves this app's APIs
# (auth, database, edge functions, etc.).
#
# How to obtain it:
#   1. In the Atoms platform, click the "Publish" button (top-right).
#   2. Publish the project — Atoms will generate a public URL such as:
#        https://loboko-xxx.atoms.dev
#   3. Copy that URL and set it below.
#
# Notes:
#   - No trailing slash. Both `https://xxx.atoms.dev` and
#     `https://xxx.atoms.dev/` are accepted (trailing slash auto-stripped).
#   - The frontend SDK (@metagptx/web-sdk) will prefix all `/api/v1/...`
#     calls with this URL, so login/register/messages will hit the
#     Atoms backend instead of Vercel.
#   - CORS is handled automatically by the Atoms platform for published apps.
#
VITE_ATOMS_API_URL=https://your-project.atoms.dev

# -----------------------------------------------------------------------------
# VITE_API_BASE_URL  (legacy, optional)
# -----------------------------------------------------------------------------
# Kept for backward compatibility. If VITE_ATOMS_API_URL is set, this is
# ignored. Only use this if you have an older deployment relying on it.
#
# VITE_API_BASE_URL=https://your-project.atoms.dev